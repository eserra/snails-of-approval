generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("editor") // admin, editor, viewer
  createdAt    DateTime @default(now()) @map("created_at")

  snails              Snail[]
  assignedSnails      Snail[]       @relation("assignedSnails")
  authoredNotes       Note[]        @relation("authoredNotes")
  authoredCheckIns    CheckIn[]     @relation("authoredCheckIns")
  uploadedAttachments Attachment[]  @relation("uploadedAttachments")
  gmailAccount        GmailAccount?

  @@map("users")
}

model Chapter {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  state     String
  createdAt DateTime @default(now()) @map("created_at")

  snails       Snail[]
  gmailAccount GmailAccount?

  @@map("chapters")
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now()) @map("created_at")

  snails Snail[]

  @@map("categories")
}

model Snail {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  // The year this business first held a Snail of Approval. Hand-entered from
  // historical records; null means the year isn't known, which is a legitimate
  // answer for old awardees rather than missing data. Nothing is computed from
  // it — the certification/recertification clock is a separate concern.
  yearFirstAwarded Int?     @map("year_first_awarded")
  description      String?  @db.Text
  website          String?
  facebookUrl      String?  @map("facebook_url")
  instagramHandle  String?  @map("instagram_handle")
  otherSocial      String?  @map("other_social")
  photoUrl         String?  @map("photo_url")
  status           String   @default("draft") // draft, published
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // CRM Pipeline
  track          String  @default("lead") @map("track")
  stage          String? @map("stage")
  formerAwardee  Boolean @default(false) @map("former_awardee")
  businessStatus String? @map("business_status")
  source         String?
  blockedReason  String? @map("blocked_reason")

  // Board decision (SOA team recommendation → board vote)
  recommendation    String?   @map("recommendation") @db.Text
  boardDecision     String?   @map("board_decision") // approved | rejected
  boardDecisionDate DateTime? @map("board_decision_date")

  // Geography lives on Location (a snail may have several); the main one is
  // Location.isPrimary.

  // SFUSA national mapping
  onSfusaMap Boolean @default(false) @map("on_sfusa_map")

  // Transitional (to be removed once SFUSA categories fully adopted)
  establishmentType String? @map("establishment_type")

  // CRM tracking
  assigneeId               Int?      @map("assignee_id")
  lastTouchDate            DateTime? @map("last_touch_date")
  welcomeLetterSent        Boolean   @default(false) @map("welcome_letter_sent")
  stickersDelivered        Boolean   @default(false) @map("stickers_delivered")
  digitalAssetsSent        Boolean   @default(false) @map("digital_assets_sent")
  certificateSent          Boolean   @default(false) @map("certificate_sent")
  certificateRequestedDate DateTime? @map("certificate_requested_date")
  pressReleaseSent         Boolean   @default(false) @map("press_release_sent")
  socialAnnounced          Boolean   @default(false) @map("social_announced")
  diversityTags            String?   @map("diversity_tags")

  // Relations
  categoryId  Int?         @map("category_id")
  category    Category?    @relation(fields: [categoryId], references: [id])
  chapterId   Int          @map("chapter_id")
  chapter     Chapter      @relation(fields: [chapterId], references: [id])
  createdById Int?         @map("created_by_id")
  createdBy   User?        @relation(fields: [createdById], references: [id])
  assignee    User?        @relation("assignedSnails", fields: [assigneeId], references: [id])
  contacts    Contact[]
  locations   Location[]
  notes       Note[]
  checkIns    CheckIn[]
  attachments Attachment[]
  emails      EmailCache[]

  @@map("snails")
}

model Contact {
  id          Int      @id @default(autoincrement())
  name        String
  // A contact can hold several roles at once — a chef who is also the owner is
  // one person, not two contacts. Machine-readable values, never display
  // labels: they're written straight into the Mailchimp ROLE merge field that
  // segments key off. Vocabulary lives in lib/contact-roles.ts.
  //
  // Empty means the roles aren't known yet, which is why there's no "general"
  // catch-all: an empty list says that honestly instead of filing everyone
  // under a category that segments can't use.
  roles       String[] @default([])
  email       String?
  phone       String?
  phoneVanity String?  @map("phone_vanity")
  isPublic    Boolean  @default(false) @map("is_public")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  snailId Int   @map("snail_id")
  snail   Snail @relation(fields: [snailId], references: [id], onDelete: Cascade)

  @@index([snailId])
  @@map("contacts")
}

model Location {
  id        Int      @id @default(autoincrement())
  label     String?
  kind      String   @default("storefront") // see lib/location-kinds.ts
  address   String?
  city      String?
  state     String?
  borough   String?
  zip       String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isPublic  Boolean  @default(true) @map("is_public")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  snailId Int   @map("snail_id")
  snail   Snail @relation(fields: [snailId], references: [id], onDelete: Cascade)

  @@index([snailId])
  @@map("locations")
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  snailId  Int   @map("snail_id")
  snail    Snail @relation(fields: [snailId], references: [id], onDelete: Cascade)
  authorId Int   @map("author_id")
  author   User  @relation("authoredNotes", fields: [authorId], references: [id])

  @@map("notes")
}

model CheckIn {
  id        Int      @id @default(autoincrement())
  visitedAt DateTime @map("visited_at") // date of the visit / engagement
  partySize Int      @map("party_size") // number of people present
  occasion  String? // optional — what the occasion was
  amount    Decimal? @db.Decimal(10, 2) // optional — $ spent at the snail
  notes     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  snailId  Int   @map("snail_id")
  snail    Snail @relation(fields: [snailId], references: [id], onDelete: Cascade)
  authorId Int   @map("author_id")
  author   User  @relation("authoredCheckIns", fields: [authorId], references: [id])

  @@index([snailId])
  @@index([visitedAt])
  @@map("check_ins")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  fileType  String   @map("file_type")
  fileSize  Int      @map("file_size")
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  snailId      Int   @map("snail_id")
  snail        Snail @relation(fields: [snailId], references: [id], onDelete: Cascade)
  uploadedById Int   @map("uploaded_by_id")
  uploadedBy   User  @relation("uploadedAttachments", fields: [uploadedById], references: [id])

  @@map("attachments")
}

model GmailAccount {
  id           Int      @id @default(autoincrement())
  emailAddress String   @map("email_address")
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  tokenExpiry  DateTime @map("token_expiry")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  chapterId Int?     @unique @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userId    Int?     @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailCache EmailCache[]

  @@map("gmail_accounts")
}

model EmailCache {
  id             Int      @id @default(autoincrement())
  gmailMessageId String   @map("gmail_message_id")
  threadId       String   @map("thread_id")
  subject        String?
  fromAddress    String   @map("from_address")
  toAddresses    String   @map("to_addresses")
  snippet        String?  @db.Text
  receivedAt     DateTime @map("received_at")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  gmailAccountId Int          @map("gmail_account_id")
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  snailId        Int?         @map("snail_id")
  snail          Snail?       @relation(fields: [snailId], references: [id], onDelete: SetNull)

  @@unique([gmailAccountId, gmailMessageId])
  @@index([snailId])
  @@index([gmailAccountId, receivedAt])
  @@index([fromAddress])
  @@map("email_cache")
}
